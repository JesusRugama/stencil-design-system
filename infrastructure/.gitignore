# Terraform state files - NEVER commit these!
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash log files
crash.log
crash.*.log

# Terraform variable files with sensitive data
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan

# Terraform lock files for modules
.terraform/
.terraform.lock.hcl

# Terraform CLI configuration files
.terraformrc
terraform.rc

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
